{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/sanmarcos/application.log",
            "log_group_name": "/aws/sanmarcos/backend",
            "log_stream_name": "{instance_id}/application",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/sanmarcos/heartbeat.log",
            "log_group_name": "/aws/sanmarcos/heartbeat",
            "log_stream_name": "{instance_id}/heartbeat",
            "retention_in_days": 14
          }
        ]
      }
    }
  }
}
